// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Tracks Stripe webhook event IDs that have already been applied, so
// Stripe's at-least-once redelivery can't re-run state transitions or
// re-send emails.
model ProcessedStripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())

  @@map("processed_stripe_events")
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String?
  tokenVersion        Int       @default(1)
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  @@map("admins")
}

model Service {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  tagline      String?
  description  String?  @db.Text
  fullDetails  String?  @db.Text
  image        String?
  features     String?  @db.Text // JSON string array
  benefits     String?  @db.Text // JSON string array
  iconName     String   @default("Car")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("services")
}

model Vehicle {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  category          String   @default("Executive")
  model             String   @default("")
  tagline           String?
  passengerCapacity Int      @default(4)
  luggageCapacity   Int      @default(3)
  rateHourly        Float?
  baseFare          Float? // flat fare for trips at or under baseMiles
  baseMiles         Float? // distance threshold covered by baseFare
  perMileRate       Float? // $/mile applied to total distance when over baseMiles
  description       String?  @db.Text
  image             String?
  features          String?  @db.Text // JSON string array
  amenities         String?  @db.Text // JSON string array
  ctaType           String   @default("both") // "both" | "book" | "quote"
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("vehicles")
}

model Passenger {
  id                  String    @id @default(uuid())
  fullName            String
  email               String    @unique
  passwordHash        String
  phone               String?
  stripeCustomerId    String?   @unique
  tokenVersion        Int       @default(1)
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bookings Booking[]

  @@map("passengers")
}

model Booking {
  id                 String        @id @default(uuid())
  confirmationNumber String        @unique
  fullName           String
  email              String
  phone              String
  serviceType        String
  vehicleSlug        String?
  pickupLocation     String
  dropoffLocation    String?
  stops              String?       @db.Text // JSON-encoded array of intermediate stop addresses, in ride order
  pickupDate         String
  pickupTime         String
  passengers         Int           @default(1)
  luggage            Int           @default(1)
  flightNumber       String?
  specialRequests    String?       @db.Text
  status             BookingStatus @default(PENDING)

  // Passenger & Stripe Hold Tracking
  passengerId             String?
  passenger               Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  stripePaymentIntentId   String?    @unique
  stripeCheckoutSessionId String?    @unique
  paymentStatus           String     @default("PENDING") // PENDING, HOLD_PLACED, CAPTURED, CANCELLED_RELEASED, FAILED
  estimatedPrice          Float?
  capturedAmount          Float? // actual dollar amount captured — may be less than estimatedPrice on a partial capture

  // Pricing breakdown
  fareMode   String? // "hourly" | "metered"
  tipPercent Float? // 0 | 10 | 15 | 18 | 20 | null (custom)
  tipAmount  Float? // dollar amount of tip

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — set once hold is released/refunded and admin deletes the record

  @@map("bookings")
}

model SiteSetting {
  id                    String   @id @default("default")
  phoneDisplay          String   @default("(617) 784-0264")
  phoneTel              String   @default("16177840264")
  dispatchEmail         String   @default("info@gmlimoservices.com")
  serviceAddress        String   @default("Boston, Massachusetts, USA")
  heroTitleGold         String   @default("Boston Luxury Chauffeur")
  heroTitleMain         String   @default("— Logan Airport Car Service")
  heroSubtitle          String   @default("Elite Corporate Travel, Private Event Transportation & Logan Airport Transfers")
  heroImage             String? // stored path e.g. /uploads/... — falls back to /images/hero-bg.jpg when unset
  // Locations page hero
  locationsHeroTitle    String   @default("Our Service Locations")
  locationsHeroSubtitle String   @default("Luxury Executive Transport Across the Greater Area")
  locationsHeroImage    String? // stored path e.g. /uploads/...
  // Services page hero
  servicesHeroTag       String   @default("PREMIUM EXECUTIVE TRANSPORTATION")
  servicesHeroTitle     String   @default("Our Luxury Services")
  servicesHeroDesc      String?  @db.Text // falls back to a default paragraph in-app when unset
  servicesHeroImage     String? // stored path e.g. /uploads/...
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

model AboutContent {
  id String @id @default("default")

  // Hero banner
  heroTag   String  @default("PROVEN EXCELLENCE IN BOSTON")
  heroTitle String  @default("About GM Limo Services")
  heroDesc  String? @db.Text // falls back to a default paragraph in-app when unset
  heroImage String? // stored path e.g. /uploads/... — falls back to /images/about-hero-bg.webp when unset

  // "Who We Are" section
  whoTag            String  @default("OUR STORY & VISION")
  whoTitlePrefix    String  @default("10+ Years of")
  whoTitleHighlight String  @default("Uncompromising Quality")
  whoDesc           String? @db.Text // falls back to a default paragraph in-app when unset
  whoText1          String? @db.Text // falls back to a default paragraph in-app when unset
  whoText2          String? @db.Text // falls back to a default paragraph in-app when unset
  whoImage          String? // stored path e.g. /uploads/... — falls back to /images/about-drivers.jpg when unset
  // JSON array of { icon, title, desc } — icon is a key into lib/aboutIcons.ts
  featureBoxes      String? @db.Text

  // Core Pillars / Service Commitment section
  pillarsTag   String  @default("SERVICE COMMITMENT")
  pillarsTitle String  @default("The GM Luxury Standard")
  pillarsDesc  String? @db.Text // falls back to a default paragraph in-app when unset
  // JSON array of { title, desc }
  pillars      String? @db.Text

  // Stats counter section
  statsTag    String  @default("MILESTONES OF SUCCESS")
  statsHeader String  @default("Trusted By Executives & Travelers Nationwide")
  statsImage  String? // stored path — falls back to /images/Boston-Luxury-Chauffeur.webp when unset
  // JSON array of { value, label }
  stats       String? @db.Text

  // Dual CTA cards
  cta1Tag     String  @default("INDIVIDUAL & FAMILY TRAVEL")
  cta1Title   String  @default("Reserve Your Private Executive Chauffeur")
  cta1BtnText String  @default("Book Online Now")
  cta1BtnLink String  @default("/book")
  cta1Image   String? // falls back to /images/Event-Transportation-e1763052056749.webp when unset

  cta2Tag     String  @default("CORPORATE ACCOUNTS")
  cta2Title   String  @default("Need Custom Billing or Fleet Dispatch?")
  cta2BtnText String  @default("Contact Corporate Team")
  cta2BtnLink String  @default("/contact")
  cta2Image   String? // falls back to /images/City-to-City-Transfer-e1763051857279.webp when unset

  updatedAt DateTime @updatedAt

  @@map("about_content")
}

model Location {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("locations")
}

model AirportTravelRate {
  id           String   @id @default(uuid())
  location     String
  distance     String
  time         String
  price        String?
  pickupZone   String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("airport_travel_rates")
}
