// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("admins")
}

model Service {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String   @db.Text
  fullDetails  String   @db.Text
  image        String
  features     String   @db.Text // JSON string array
  benefits     String   @db.Text // JSON string array
  iconName     String   @default("Car")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("services")
}

model Vehicle {
  id                String   @id @default(uuid())
  slug              String   @unique
  name              String
  category          String
  model             String
  passengerCapacity Int
  luggageCapacity   Int
  rateHourly        Float?
  description       String   @db.Text
  image             String
  features          String   @db.Text // JSON string array
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("vehicles")
}

model Airport {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String   @db.Text
  sedanEstimate String?
  suvEstimate   String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("airports")
}

model Passenger {
  id               String    @id @default(uuid())
  fullName         String
  email            String    @unique
  passwordHash     String
  phone            String?
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bookings         Booking[]

  @@map("passengers")
}

model Booking {
  id                 String        @id @default(uuid())
  confirmationNumber String        @unique
  fullName           String
  email              String
  phone              String
  serviceType        String
  vehicleSlug        String?
  pickupLocation     String
  dropoffLocation    String?
  pickupDate         String
  pickupTime         String
  passengers         Int           @default(1)
  luggage            Int           @default(1)
  flightNumber       String?
  specialRequests    String?       @db.Text
  status             BookingStatus @default(PENDING)

  // Passenger & Stripe Hold Tracking
  passengerId           String?
  passenger             Passenger? @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  stripePaymentIntentId String?    @unique
  paymentStatus         String     @default("PENDING") // PENDING, HOLD_PLACED, CAPTURED, CANCELLED_RELEASED, FAILED
  estimatedPrice        Float?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("bookings")
}

model SiteSetting {
  id             String   @id @default("default")
  phoneDisplay   String   @default("(617) 784-0264")
  phoneTel       String   @default("16177840264")
  dispatchEmail  String   @default("info@bostonluxurychauffeur.com")
  serviceAddress String   @default("Boston, Massachusetts, USA")
  heroTitleGold  String   @default("Boston Luxury Chauffeur")
  heroTitleMain  String   @default("— Logan Airport Car Service")
  heroSubtitle   String   @default("Elite Corporate Travel, Private Event Transportation & Logan Airport Transfers")
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}
